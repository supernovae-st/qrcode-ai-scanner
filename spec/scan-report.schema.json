{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/supernovae-st/qrcode-ai-scanner/spec/scan-report.schema.json",
  "title": "ScanReport",
  "description": "qrcode-ai-scanner wire contract (versions.pipeline=2, score_contract=4). Additive evolution: consumers must tolerate unknown fields and unknown enum/tag values.",
  "type": "object",
  "required": [
    "detections",
    "score",
    "hints",
    "trace",
    "versions"
  ],
  "properties": {
    "detections": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/Detection"
      }
    },
    "score": {
      "anyOf": [
        {
          "$ref": "#/$defs/Score"
        },
        {
          "type": "null"
        }
      ]
    },
    "hints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Hint"
      }
    },
    "trace": {
      "$ref": "#/$defs/PipelineTrace"
    },
    "versions": {
      "$ref": "#/$defs/Versions"
    },
    "alpha": {
      "description": "Alpha-transparency handling — ABSENT (not null) for opaque inputs and under alphaBackground:none.",
      "$ref": "#/$defs/AlphaReport"
    }
  },
  "$defs": {
    "Point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "EngineKind": {
      "enum": [
        "rxing",
        "rqrr",
        "rescue"
      ]
    },
    "EcLevel": {
      "enum": [
        "l",
        "m",
        "q",
        "h"
      ]
    },
    "Charset": {
      "enum": [
        "utf8",
        "shift_jis",
        "latin1"
      ]
    },
    "Grade": {
      "enum": [
        "excellent",
        "good",
        "acceptable",
        "fair",
        "poor"
      ]
    },
    "IsoGrade": {
      "enum": [
        "a",
        "b",
        "c",
        "d",
        "f"
      ]
    },
    "StressAxis": {
      "enum": [
        "resolution",
        "blur",
        "contrast",
        "perspective",
        "rotation",
        "lighting"
      ]
    },
    "Gs1Element": {
      "type": "object",
      "required": [
        "ai",
        "value"
      ],
      "properties": {
        "ai": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "Payload": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "url"
              }
            }
          },
          "then": {
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "wifi"
              }
            }
          },
          "then": {
            "required": [
              "ssid",
              "security",
              "hidden"
            ],
            "properties": {
              "ssid": {
                "type": "string"
              },
              "security": {
                "type": "string"
              },
              "password": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "hidden": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "gs1",
                  "gs1_digital_link"
                ]
              }
            }
          },
          "then": {
            "required": [
              "elements",
              "gtin",
              "conformant",
              "issues"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "elements": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Gs1Element"
                }
              },
              "gtin": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "conformant": {
                "type": "boolean"
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "geo"
              }
            }
          },
          "then": {
            "required": [
              "lat",
              "lon"
            ],
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "crypto"
              }
            }
          },
          "then": {
            "required": [
              "scheme",
              "address"
            ],
            "properties": {
              "scheme": {
                "type": "string"
              },
              "address": {
                "type": "string"
              },
              "amount": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "email"
              }
            }
          },
          "then": {
            "required": [
              "to"
            ],
            "properties": {
              "to": {
                "type": "string"
              },
              "subject": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "body": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sms"
              }
            }
          },
          "then": {
            "required": [
              "number"
            ],
            "properties": {
              "number": {
                "type": "string"
              },
              "body": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tel"
              }
            }
          },
          "then": {
            "required": [
              "number"
            ],
            "properties": {
              "number": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "me_card"
              }
            }
          },
          "then": {
            "required": [
              "name",
              "tel",
              "email",
              "url"
            ],
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tel": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "email": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "v_card",
                  "v_event"
                ]
              }
            }
          },
          "then": {
            "required": [
              "raw"
            ],
            "properties": {
              "raw": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "DecodedContent": {
      "type": "object",
      "required": [
        "text",
        "raw",
        "charset"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "raw": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "charset": {
          "$ref": "#/$defs/Charset"
        }
      }
    },
    "QrMeta": {
      "type": "object",
      "required": [
        "version",
        "ec_level",
        "mask",
        "modules",
        "inverted"
      ],
      "properties": {
        "version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 40
        },
        "ec_level": {
          "anyOf": [
            {
              "$ref": "#/$defs/EcLevel"
            },
            {
              "type": "null"
            }
          ]
        },
        "mask": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 7
        },
        "modules": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 21,
          "maximum": 177
        },
        "inverted": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "Detection": {
      "type": "object",
      "required": [
        "symbology",
        "content",
        "payload",
        "corners",
        "meta",
        "engines"
      ],
      "properties": {
        "symbology": {
          "$ref": "#/$defs/Symbology"
        },
        "content": {
          "$ref": "#/$defs/DecodedContent"
        },
        "payload": {
          "$ref": "#/$defs/Payload"
        },
        "corners": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/Point"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "meta": {
          "$ref": "#/$defs/QrMeta"
        },
        "engines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/EngineKind"
          }
        }
      }
    },
    "AxisScore": {
      "type": "object",
      "required": [
        "axis",
        "passed",
        "total",
        "failed_at"
      ],
      "properties": {
        "axis": {
          "$ref": "#/$defs/StressAxis"
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "failed_at": {
          "description": "Wire label of the first failed cell — why this axis lost points (e.g. 'blur 2.5', 'glare', '128px'). Null when every cell passed.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "StructuralReport": {
      "type": "object",
      "required": [
        "finder_integrity",
        "quiet_zone_ok"
      ],
      "properties": {
        "finder_integrity": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "quiet_zone_ok": {
          "type": "boolean"
        }
      }
    },
    "UecReport": {
      "type": "object",
      "required": [
        "margin",
        "grade",
        "worst_block_errors",
        "worst_block_capacity"
      ],
      "properties": {
        "margin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "grade": {
          "$ref": "#/$defs/IsoGrade"
        },
        "worst_block_errors": {
          "type": "integer",
          "minimum": 0
        },
        "worst_block_capacity": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "IsoParameter": {
      "type": "object",
      "required": [
        "value",
        "grade"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "grade": {
          "$ref": "#/$defs/IsoGrade"
        }
      }
    },
    "Iso15415Report": {
      "type": "object",
      "required": [
        "symbol_contrast",
        "modulation",
        "axial_nonuniformity",
        "fixed_pattern_damage",
        "unused_error_correction",
        "overall"
      ],
      "properties": {
        "symbol_contrast": {
          "$ref": "#/$defs/IsoParameter"
        },
        "modulation": {
          "$ref": "#/$defs/IsoParameter"
        },
        "axial_nonuniformity": {
          "$ref": "#/$defs/IsoParameter"
        },
        "fixed_pattern_damage": {
          "$ref": "#/$defs/IsoParameter"
        },
        "unused_error_correction": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoParameter"
            },
            {
              "type": "null"
            }
          ]
        },
        "overall": {
          "$ref": "#/$defs/IsoGrade"
        }
      }
    },
    "Score": {
      "type": "object",
      "required": [
        "value",
        "grade",
        "axes",
        "structural",
        "uec",
        "iso15415"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "grade": {
          "$ref": "#/$defs/Grade"
        },
        "axes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AxisScore"
          }
        },
        "structural": {
          "anyOf": [
            {
              "$ref": "#/$defs/StructuralReport"
            },
            {
              "type": "null"
            }
          ]
        },
        "uec": {
          "anyOf": [
            {
              "$ref": "#/$defs/UecReport"
            },
            {
              "type": "null"
            }
          ]
        },
        "iso15415": {
          "anyOf": [
            {
              "$ref": "#/$defs/Iso15415Report"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Hint": {
      "type": "object",
      "required": [
        "hint"
      ],
      "properties": {
        "hint": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "hint": {
                "const": "raise_error_correction"
              }
            }
          },
          "then": {
            "required": [
              "current"
            ],
            "properties": {
              "current": {
                "$ref": "#/$defs/EcLevel"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "hint": {
                "const": "fix_finder_pattern"
              }
            }
          },
          "then": {
            "required": [
              "corner"
            ],
            "properties": {
              "corner": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "hint": {
                "const": "low_correction_margin"
              }
            }
          },
          "then": {
            "required": [
              "errors",
              "capacity"
            ],
            "properties": {
              "errors": {
                "type": "integer",
                "minimum": 0
              },
              "capacity": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "hint": {
                "const": "alpha_background_dependent"
              }
            }
          },
          "then": {
            "required": [
              "placement"
            ],
            "properties": {
              "placement": {
                "$ref": "#/$defs/AlphaPlacement"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "hint": {
                "const": "add_background_plate"
              }
            }
          },
          "then": {
            "required": [
              "color"
            ],
            "properties": {
              "color": {
                "enum": [
                  "white",
                  "black"
                ]
              }
            }
          }
        }
      ]
    },
    "StageTrace": {
      "type": "object",
      "required": [
        "stage",
        "transforms_tried",
        "ms",
        "detections_found"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "transforms_tried": {
          "type": "integer",
          "minimum": 0
        },
        "ms": {
          "type": "number",
          "minimum": 0
        },
        "detections_found": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "PipelineTrace": {
      "type": "object",
      "required": [
        "stages",
        "engine_panics",
        "total_ms"
      ],
      "properties": {
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StageTrace"
          }
        },
        "engine_panics": {
          "type": "integer",
          "minimum": 0
        },
        "total_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "Versions": {
      "type": "object",
      "required": [
        "scanner",
        "pipeline",
        "score_contract"
      ],
      "properties": {
        "scanner": {
          "type": "string"
        },
        "pipeline": {
          "type": "integer",
          "const": 2
        },
        "score_contract": {
          "type": "integer",
          "const": 4
        }
      }
    },
    "Symbology": {
      "enum": [
        "qr_code",
        "micro_qr_code",
        "rectangular_micro_qr_code",
        "data_matrix",
        "aztec",
        "pdf417",
        "maxi_code",
        "ean13",
        "ean8",
        "upc_a",
        "upc_e",
        "code128",
        "code39",
        "code93",
        "codabar",
        "itf",
        "data_bar",
        "data_bar_expanded",
        "telepen"
      ]
    },
    "AlphaMode": {
      "enum": [
        "auto",
        "white",
        "black",
        "custom"
      ]
    },
    "AlphaPlacement": {
      "enum": [
        "any",
        "light_only",
        "dark_only",
        "mixed",
        "none"
      ]
    },
    "AlphaProbe": {
      "type": "object",
      "required": [
        "background_luma",
        "decoded"
      ],
      "properties": {
        "background_luma": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "decoded": {
          "type": "boolean"
        }
      }
    },
    "AlphaEnvelope": {
      "type": "object",
      "required": [
        "probes",
        "safe_luma",
        "placement",
        "palette"
      ],
      "properties": {
        "probes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AlphaProbe"
          }
        },
        "safe_luma": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "placement": {
          "$ref": "#/$defs/AlphaPlacement"
        },
        "palette": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AlphaPaletteProbe"
          }
        }
      }
    },
    "AlphaReport": {
      "type": "object",
      "required": [
        "coverage",
        "content_luma",
        "mode",
        "background",
        "fallback_used",
        "envelope"
      ],
      "properties": {
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "content_luma": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "mode": {
          "$ref": "#/$defs/AlphaMode"
        },
        "background": {
          "type": "string"
        },
        "fallback_used": {
          "type": "boolean"
        },
        "envelope": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlphaEnvelope"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AlphaPaletteProbe": {
      "type": "object",
      "required": [
        "background",
        "background_luma",
        "decoded"
      ],
      "properties": {
        "background": {
          "type": "string"
        },
        "background_luma": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "decoded": {
          "type": "boolean"
        }
      }
    }
  }
}
