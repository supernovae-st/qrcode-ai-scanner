# A benchmark worker built OUTSIDE the scanner workspace: its own
# [workspace] root (so neither the workspace manifests nor its lockfile
# change), a lockfile seeded from the workspace Cargo.lock, and the
# workspace release profile mirrored, so base and candidate build alike.
# @VARIANT@: base = the published crate, candidate = this tree by path.

[package]
name = "qrscan-bench-worker-@VARIANT@"
version = "0.0.0"
