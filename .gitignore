bindings/kotlin/**/src/main/kotlin/
bindings/kotlin/**/build/
bindings/kotlin/.gradle/
bindings/kotlin/local.properties
# Swift (bindings/swift/): generated Swift sources + the xcframework
bindings/swift/Sources/QrcodeAiScanner/
bindings/swift/build/
*.xcframework
*.xcframework.zip
# Repo-root build/ staging dir that mobile.yml + bindings/swift/release.sh write
